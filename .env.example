# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 깃에 올라가지 않습니다.

# ---- LLM 기반 추천 이유(ai_reason) 생성 ----
# false(기본값)면 backend/explanations.py가 규칙 기반 문장을 사용합니다.
# true로 켜려면 아래 OPENAI_API_KEY / OPENAI_MODEL도 함께 채워야 합니다.
ENABLE_LLM=false

# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# 예: gpt-4o-mini
OPENAI_MODEL=

# ---- 그 외 기존 설정 (필요할 때만 수정) ----
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# SOADAL_DATA_DIR=data
