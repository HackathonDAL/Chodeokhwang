# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 깃에 올라가지 않습니다.

# ---- LLM 기반 추천 이유(ai_reason) 생성 (Google Gemini) ----
# false(기본값)면 backend/explanations.py가 규칙 기반 문장을 사용합니다.
# true로 켜려면 아래 GEMINI_API_KEY / GEMINI_MODEL도 함께 채워야 합니다.
ENABLE_LLM=false

# https://aistudio.google.com/apikey 에서 무료로 발급 (Google 계정만 있으면 됨)
GEMINI_API_KEY=

# 예: gemini-2.0-flash
GEMINI_MODEL=

# ---- 그 외 기존 설정 (필요할 때만 수정) ----
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# SOADAL_DATA_DIR=data
